<!-- 連絡先（content/config.js の support）。未設定なら「担当者に連絡してください」とだけ出す。 -->
<template>
  <span v-if="!c"><b>研修の担当者（サポート窓口）に連絡してください。</b><br />連絡先が分からないときは、この研修を案内してくれた人に聞けば大丈夫です。</span>
  <span v-if="c">連絡先: <a v-if="c && c.url" :href="c.url" target="_blank" rel="noopener">{{ c.name }}</a><span v-if="c && !c.url">{{ c.name }}</span>{{ c && c.channel ? '（' + c.channel + '）' : '' }}<br v-if="c && c.note" /><span v-if="c && c.note" class="fd">{{ c.note }}</span></span>
</template>

<script>
import { contact } from '../lib/support.js';

export default {
  name: 'Contact',
  setup() {
    return { c: contact() };
  },
};
</script>
