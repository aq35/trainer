<!-- 「参画の準備ができました」の申請（本文の <div id="joinbtn"></div>）。到達状況を入れた状態で開く／コピーする。 -->
<template>
  <div class="mapreport">
    <b>準備ができたことを、担当者に知らせます</b><br />
    <span v-if="url" class="mrsub">押すと、<b>いまの到達状況が入力済み</b>の状態で申請の画面が開きます。成果物のURLと、自信が無いところを書き足して送ってください。<br /><b>全部のステップが終わっていなくても構いません。</b>相談の入口です。</span>
    <a v-if="url" class="mrbtn" :href="url" target="_blank" rel="noopener">参画の相談をする</a>
    <span v-if="!url" class="mrsub">押すと、<b>いまの到達状況が文章になってコピー</b>されます。成果物のURLと、自信が無いところを書き足して、いつもの方法で送ってください。<br /><b>全部のステップが終わっていなくても構いません。</b>相談の入口です。<br />{{ contact }}</span>
    <button v-if="!url" type="button" class="mrbtn" @click="copyJoin">参画の相談をコピー</button>
  </div>
</template>

<script>
import { joinText, joinUrl } from '../progress.js';
import { contactLine } from '../../lib/support.js';
import { copy } from '../../lib/toast.js';

export default {
  name: 'JoinButton',
  setup() {
    const copyJoin = () => copy(joinText().text, 'コピーしました。担当者に送ってください');
    return { url: joinUrl(), contact: contactLine(), copyJoin };
  },
};
</script>
