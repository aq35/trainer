<!--
  最終チェックで、チェックが付いていない項目を集めてコピーする（本文の <div id="weakcopy"></div>）。
  逆算プランナーの「まだ自信が無いところ」に貼るためのもの。チェックを付けるたびに数が変わる。
-->
<template>
  <div class="mapreport">
    <b v-if="!weak().length">チェックが全部付きました。おつかれさまでした。</b>
    <b v-if="weak().length">まだチェックが付いていない項目が {{ weak().length }} 件あります</b><br />
    <span v-if="!weak().length" class="mrsub">それでも不安なところがあれば、逆算プランナーに自分の言葉で書いてください。</span>
    <span v-if="weak().length" class="mrsub">押すと、その一覧がコピーされます。<b>次の「逆算プランナー」の「まだ自信が無いところ」に貼ってください。</b><br />そこを埋める計画を、AIが作ります。</span>
    <button v-if="weak().length" type="button" class="mrbtn" @click="copyWeak">できていない項目をコピー</button>
  </div>
</template>

<script>
import { doc, checks } from '../state.js';
import { copy } from '../../lib/toast.js';

export default {
  name: 'WeakCopy',
  setup() {
    const tasks = (doc.peek() && doc.peek().tasks) || [];
    const weak = () => { const c = checks(); return tasks.filter((t, i) => !c[i]).map((t) => '- ' + t); };
    const copyWeak = () => copy(['まだ自信が無いところ（' + weak().length + '件）', ''].concat(weak()).join('\n'), 'コピーしました。逆算プランナーに貼ってください');
    return { weak, copyWeak };
  },
};
</script>
